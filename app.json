{
  "expo": {
    "name": "Muzify-App",
    "slug": "Muzify-App",
    "version": "1.0.0",
    "scheme": "muzify",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 1,
      "package": "com.aaditya_aks.muzify"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Muzify uses your photos for welcome screen backgrounds.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": ["audio"],
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./config-plugins/withMuzifyPermissions.js",
      "./config-plugins/withJaudiotagger.js",
      "./modules/audio-metadata/app.plugin.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc8976eb-c084-4c3b-9ce1-22bd190e0cb0"
      }
    }
  }
}
